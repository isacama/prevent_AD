#!/bin/bash
#BSUB -J "prevent-AD_tabpfn[1-50]"
#BSUB -P jamlab
#BSUB -o /projectnb/jamlab/bsub_output/out.%J.%I
#BSUB -e /projectnb/jamlab/bsub_output/err.%J.%I
#BSUB -W 02:00
#BSUB -q gpu_h100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 4
#BSUB -R "rusage[mem=16G]"
#BSUB -u YOUR_EMAIL

module load anaconda3
source /share/apps/anaconda/anaconda3_build/bin/activate
conda activate /projectnb/jamlab/ixc751/conda_envs/prevent_AD

export PROJECT_DIR="/projectnb/jamlab/ixc751"
export HOME="${PROJECT_DIR}"
export XDG_CACHE_HOME="${PROJECT_DIR}/.cache"
export TABPFN_CACHE_DIR="${PROJECT_DIR}/.cache/tabpfn"
export TORCH_HOME="${PROJECT_DIR}/.cache/torch"
export HF_HOME="${PROJECT_DIR}/.cache/huggingface"
export TABPFN_TOKEN="PASTE_TOKEN_HERE"

# Optimize CUDA thread allocation for parallel joblib tasks
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
export OMP_NUM_THREADS=1

mkdir -p "$TABPFN_CACHE_DIR" "$TORCH_HOME" "$HF_HOME" /projectnb/jamlab/bsub_output
cd "$PROJECT_DIR"

python -u prevent-AD_sklearn_tabpfn_flexible.py