#!/bin/bash
#BSUB -J "prevent-AD_tabpfn_cpu[1-60]"
#BSUB -P jamlab
#BSUB -o /projectnb/jamlab/bsub_output/out_cpu.%J.%I
#BSUB -e /projectnb/jamlab/bsub_output/err_cpu.%J.%I
#BSUB -W 12:00
#BSUB -q general
#BSUB -n 8
#BSUB -R "span[hosts=1] rusage[mem=2G]"
#BSUB -u YOUR_EMAIL

# CPU-only version: no GPU requested, so TabPFN runs with device="cpu".
# Note: rusage mem is per core on many LSF setups (8 x 2G = 16G total).

# --- Environment ---------------------------------------------------------
module load anaconda3
source /share/apps/anaconda/anaconda3_build/bin/activate
conda activate /projectnb/jamlab/ixc751/conda_envs/prevent_AD

export PROJECT_DIR="/projectnb/jamlab/ixc751"
export HOME="${PROJECT_DIR}"
export XDG_CACHE_HOME="${PROJECT_DIR}/.cache"
export TABPFN_CACHE_DIR="${PROJECT_DIR}/.cache/tabpfn"
export TORCH_HOME="${PROJECT_DIR}/.cache/torch"
export HF_HOME="${PROJECT_DIR}/.cache/huggingface"

export TABPFN_TOKEN="PASTE_TOKEN_HERE"

# Use all 8 requested cores (TabPFN on CPU uses PyTorch threads)
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

# Run settings
export MODEL_TYPE="tabpfn"
export N_PERM=1000          # 100 for screening; 1000 for final runs

mkdir -p "$TABPFN_CACHE_DIR" "$TORCH_HOME" "$HF_HOME" /projectnb/jamlab/bsub_output
cd "$PROJECT_DIR"

echo "Array task ${LSB_JOBINDEX} on $(hostname) at $(date)"
echo "CPU: $(lscpu | grep 'Model name' | sed 's/Model name:\s*//')"
echo "Script: $(ls -l ${PROJECT_DIR}/prevent-AD_sklearn_tabpfn_flexible.py)"

python -u prevent-AD_sklearn_tabpfn_flexible.py

echo "Finished at $(date)"
