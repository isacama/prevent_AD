#!/bin/bash
#BSUB -J "tabpfn_rf_cpu[1-60]"
#BSUB -P jamlab
#BSUB -o /projectnb/jamlab/bsub_output/out_rfcpu.%J.%I
#BSUB -e /projectnb/jamlab/bsub_output/err_rfcpu.%J.%I
#BSUB -W 24:00
#BSUB -q normal
#BSUB -n 8
#BSUB -R "span[hosts=1] rusage[mem=2G]"
#BSUB -u YOUR_EMAIL

# TabPFN on the Random Forest top-20 features (selected inside each CV fold).
# CPU version for the 'normal' queue.

module load anaconda3
source /share/apps/anaconda/anaconda3_build/bin/activate
conda activate /projectnb/jamlab/ixc751/conda_envs/prevent_AD

export PROJECT_DIR="/projectnb/jamlab/ixc751"
export HOME="${PROJECT_DIR}"
export XDG_CACHE_HOME="${PROJECT_DIR}/.cache"
export TABPFN_CACHE_DIR="${PROJECT_DIR}/.cache/tabpfn"
export TORCH_HOME="${PROJECT_DIR}/.cache/torch"
export HF_HOME="${PROJECT_DIR}/.cache/huggingface"

export TABPFN_TOKEN="PASTE_TOKEN_HERE"

export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

# Run settings
export MODEL_TYPE="tabpfn"
export N_PERM=1000
export FEATURE_SELECTION="rf_infold"   # rf_infold (recommended) | rf_fulldata | none
export TOP_K=20
export RF_TREES=100

mkdir -p "$TABPFN_CACHE_DIR" "$TORCH_HOME" "$HF_HOME" /projectnb/jamlab/bsub_output
cd "$PROJECT_DIR"

echo "Array task ${LSB_JOBINDEX} on $(hostname) at $(date)"
echo "Script: $(ls -l ${PROJECT_DIR}/prevent-AD_sklearn_tabpfn_flexible.py)"

python -u prevent-AD_sklearn_tabpfn_flexible.py

echo "Finished at $(date)"
