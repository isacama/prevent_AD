#!/bin/bash
#BSUB -J "tabpfn_newout_cpu[1-132]"
#BSUB -P jamlab
#BSUB -o /projectnb/jamlab/bsub_output/out_newout.%J.%I
#BSUB -e /projectnb/jamlab/bsub_output/err_newout.%J.%I
#BSUB -W 12:00
#BSUB -q normal
#BSUB -n 8
#BSUB -R "span[hosts=1] rusage[mem=2G]"
#BSUB -u YOUR_EMAIL

# TabPFN on the 22 new BLUP outcomes x 6 brain measures = 132 pairs (one pair per array task).
# Task number = (outcome position in outcomes_new_blup.txt - 1) * 6 + predictor position,
# predictors in this order: T1T2, rsfc_entorhinal, rsfc_hipp_body, rsfc_hipp_head,
# rsfc_hipp_tail, rsfc_perirhinal.   e.g. tasks 1-6 = first outcome, 7-12 = second ...

module load anaconda3
source /share/apps/anaconda/anaconda3_build/bin/activate
conda activate /projectnb/jamlab/ixc751/conda_envs/prevent_AD

export PROJECT_DIR="/projectnb/jamlab/ixc751"
export HOME="${PROJECT_DIR}"
export XDG_CACHE_HOME="${PROJECT_DIR}/.cache"
export TABPFN_CACHE_DIR="${PROJECT_DIR}/.cache/tabpfn"
export TORCH_HOME="${PROJECT_DIR}/.cache/torch"
export HF_HOME="${PROJECT_DIR}/.cache/huggingface"

# Token: see the sed command in the instructions (copies the line from your existing job file)
export TABPFN_TOKEN="PASTE_TOKEN_HERE"

export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

# Run settings
export MODEL_TYPE="tabpfn"
export N_PERM=1000
export FEATURE_SELECTION="none"      # none (all 200 regions) | rf_infold | rf_fulldata
export TOP_K=20
export RF_TREES=100

# New-outcome settings
export OUTCOME_LIST_FILE="${PROJECT_DIR}/outcomes_new_blup.txt"
export OUTCOMES_FILE="auto"          # searches the data folder for each listed column
export RESULTS_TAG="newblup"         # results go to tabpfn_newblup/ (or tabpfn_rf_infold_top20_newblup/)

mkdir -p "$TABPFN_CACHE_DIR" "$TORCH_HOME" "$HF_HOME" /projectnb/jamlab/bsub_output
cd "$PROJECT_DIR"

echo "Array task ${LSB_JOBINDEX} on $(hostname) at $(date)"
echo "Script: $(ls -l ${PROJECT_DIR}/prevent-AD_sklearn_tabpfn_flexible.py)"

python -u prevent-AD_sklearn_tabpfn_flexible.py
status=$?
echo "Finished at $(date) with exit code $status"
exit $status
